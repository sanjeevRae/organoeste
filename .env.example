DATABASE_URL="mysql://organoeste:change-me@127.0.0.1:3306/organoeste?charset=utf8mb4"
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="organoeste"
DB_PASSWORD="change-me"
DB_NAME="organoeste"

ADMIN_PASSWORD="change-me-too"

# Optional. Absolute origin of the site (canonical URLs, JSON-LD, sitemap and the
# social preview). Without it the app falls back to https://www.organoeste.com.br
# NEXT_PUBLIC_SITE_URL="https://www.organoeste.com.br"
# NEXT_PUBLIC_OG_IMAGE="/images/d-3599093_1_17814623476a2ef54b5b726.png"
# BLOG_SOURCE="mysql"   # use "file" to read data/blog-posts.ts and ignore MySQL

# Optional. Absolute folder for the images uploaded from /admin (covers and
# editor images). Default: <cwd>/public/uploads, i.e. the folder of the app
# itself, which is also where the /media route serves the files from.
# Only set this if the panel warns that the file was saved somewhere the site
# cannot open (exotic Passenger/docroot layouts, two copies of the project).
# UPLOAD_DIR="/home/sua-conta/app-atual/public/uploads"
