# MySQL blog store — copy to .env and fill in (never commit .env).
# Option A: single URL (preferred)
DATABASE_URL="mysql://organoeste:change-me@127.0.0.1:3306/organoeste"
# Option B: discrete values (used only when DATABASE_URL is absent)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="organoeste"
DB_PASSWORD="change-me"
DB_NAME="organoeste"
# Admin dashboard password (server-only, compared as a hash):
ADMIN_PASSWORD="change-me-too"
