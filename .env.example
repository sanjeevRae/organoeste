# ─── Blog store (MySQL) ──────────────────────────────────────────────────────
# Optional: with none of these set, the blog is served from data/blog-posts.ts,
# the dashboard shows a "MySQL offline" warning and saved edits are offered as a
# downloadable file. Fill them in to make the blog fully dynamic.
#
# cPanel / shared hosting — discrete values (RECOMMENDED there, because cPanel
# passwords often contain @ # ! which would break a connection URL):
#   DB_HOST="localhost"
#   DB_PORT="3306"
#   DB_USER="conta_organoeste"     # cPanel prefixes the user with the account name
#   DB_PASSWORD="a-senha-do-painel"
#   DB_NAME="conta_organoeste"     # the database name gets the same prefix
#   DB_SSL="false"                 # "true" only if the host requires TLS
#   DB_POOL_SIZE="5"
#
# Option A — single URL (local dev / root access). Percent-encode the password
# (an @ must be written as %40):
DATABASE_URL="mysql://organoeste:change-me@127.0.0.1:3306/organoeste?charset=utf8mb4"
# Option B — discrete values (used only when DATABASE_URL is absent)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="organoeste"
DB_PASSWORD="change-me"
DB_NAME="organoeste"
# Escape hatch: force the bundled data/blog-posts.ts even when a DB is configured
# BLOG_SOURCE="file"

# Admin dashboard password (server-only, compared as a hash):
ADMIN_PASSWORD="change-me-too"
